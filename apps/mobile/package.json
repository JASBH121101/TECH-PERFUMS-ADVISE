{
  "name": "jbae-standalone-mobile",
  "version": "0.4.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "predev": "node scripts/build-seed.mjs",
    "dev": "vite --host 0.0.0.0",
    "prebuild": "node scripts/build-seed.mjs",
    "build": "vite build",
    "test": "node --test tests/*.test.js",
    "android:add": "cap add android",
    "android:sync": "cap sync android",
    "android:debug": "npm run build && cap sync android && cd android && ./gradlew assembleDebug",
    "android:release": "npm run build && cap sync android && node scripts/install-android-updater.mjs && cd android && ./gradlew assembleRelease"
  },
  "dependencies": {
    "@capacitor-community/sqlite": "8.1.1",
    "@capacitor/android": "8.6.0",
    "@capacitor/core": "8.6.0"
  },
  "devDependencies": {
    "@capacitor/cli": "8.6.0",
    "vite": "8.3.6"
  }
}
